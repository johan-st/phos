# Copy to .env and set your GCP project. Task loads .env automatically.
# Nonempty shell defaults override .env; CLI flags override environment defaults.
PHOS_GCP_PROJECT=your-project
PHOS_GCP_FILTER=
PHOS_STORE_DB=.phos/gcp.db
PHOS_ADDR=127.0.0.1:9094

# Uses existing Application Default Credentials unless explicitly overridden.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
# GOOGLE_CLOUD_QUOTA_PROJECT=your-quota-project

# respect ignore .files convention
# with exceptions
.*
!.gitignore
!.env.example


# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Large external corpora used for renderer benchmarks
/benchdata/*
!/benchdata/README.md
